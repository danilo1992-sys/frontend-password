# Copia este archivo a `.env` y ajustá el valor.
#
# VITE_API_URL = base del backend INCLUYENDO el prefijo del router.
#  - contra el backend en local (Docker / uv run en :8000):
#      VITE_API_URL="http://localhost:8000/router"
#  - contra el despliegue en Render:
#      VITE_API_URL="https://api-pasword.onrender.com/router"
VITE_API_URL="https://api-pasword.onrender.com/router"
